# =============================================================================
# ReelForge Marketing Engine - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ===========================================
# Database (Required)
# ===========================================
# Render PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# Redis (Required)
# ===========================================
# Render Redis connection string
REDIS_URL=redis://red-xxxxx:6379

# ===========================================
# YouTube Data API (Required for discovery)
# ===========================================
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIza...

# ===========================================
# Apify (Optional - for Instagram/TikTok)
# ===========================================
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# ===========================================
# Brevo - Email (Required for outreach)
# ===========================================
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=jr@reelforgeai.io
BREVO_SENDER_NAME=Jr from ReelForge

# Shared secret Brevo sends with each webhook (bearer token, X-Brevo-Webhook-Token header,
# or the password in https://brevo:<secret>@host/webhooks/brevo). Required outside development.
BREVO_WEBHOOK_SECRET=

# ===========================================
# Email Verification (Recommended)
# ===========================================
# Clearout: https://app.clearout.io/settings/api
CLEAROUT_API_KEY=

# OR Hunter.io (alternative): https://hunter.io/api_keys
HUNTER_API_KEY=

# ===========================================
# Error Monitoring (Recommended)
# ===========================================
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=

# ===========================================
# Reditus - Affiliate Tracking (Optional)
# ===========================================
REDITUS_API_KEY=
REDITUS_PROGRAM_ID=

# ===========================================
# Outreach Settings
# ===========================================
# Required before any outreach email is sent (CAN-SPAM): a street address, a USPS PO box
# or a registered private mailbox. Sending is refused while this is empty.
COMPANY_POSTAL_ADDRESS=
# false pauses Partner Scout sequence emails and auto-enrollment (README → Pausing Partner Scout outreach)
PARTNER_SCOUT_AUTO_OUTREACH_ENABLED=true
COMPANY_LEGAL_NAME=Lydell Security LLC d/b/a ReelForge AI
# Base URL for unsubscribe links (the web service)
PUBLIC_BASE_URL=https://reelforgeai-marketing.onrender.com
# Optional: signs unsubscribe links; defaults to a key derived from ADMIN_API_KEY.
# Web and worker must use the same value.
UNSUBSCRIBE_SECRET=
DAILY_EMAIL_LIMIT=50
MIN_RELEVANCE_SCORE=0.5

# ===========================================
# Discovery Filters
# ===========================================
MIN_YOUTUBE_SUBSCRIBERS=5000
MAX_YOUTUBE_SUBSCRIBERS=500000
MIN_INSTAGRAM_FOLLOWERS=5000
MIN_TIKTOK_FOLLOWERS=10000

# ===========================================
# Compliance
# ===========================================
DATA_RETENTION_DAYS=180
REQUIRE_EMAIL_VERIFICATION=true

# ===========================================
# Application
# ===========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=America/New_York

# Required in the X-Admin-Key header for /trigger/*, /keywords* and /tasks/*.
# While unset or left as the placeholder, those endpoints refuse every request.
ADMIN_API_KEY=change-me-in-production

# ===========================================
# Server
# ===========================================
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ===========================================
# Partner Intelligence (RPI) - docs/rpi/DEPLOYMENT_RUNBOOK.md
# ===========================================
# First admin access to /rpi (24+ random chars). Create real keys, then unset.
RPI_BOOTSTRAP_ADMIN_KEY=
# 16+ random chars. Salts hashed visitor ids / suppression entries and signs
# unsubscribe links. Never change it after go-live (existing hashes would stop matching).
RPI_ATTRIBUTION_HASH_SALT=
RPI_PUBLIC_BASE_URL=https://your-app.onrender.com

# Claude (reuses ANTHROPIC_API_KEY). Confirm prices against current Anthropic pricing.
ANTHROPIC_API_KEY=
RPI_CLAUDE_FAST_MODEL=claude-haiku-5-5
RPI_CLAUDE_DEEP_MODEL=claude-sonnet-5-5

# CreatorDB (primary discovery). Set USD per credit from your plan.
CREATORDB_API_KEY=
CREATORDB_USD_PER_CREDIT=0
# Extra endpoints confirmed live; the documented ones are already enabled
CREATORDB_VERIFIED_ENDPOINTS=
# Only after reviewing CreatorDB's terms for derived scoring / AI analysis:
RPI_CREATORDB_SCORING_PERMITTED=false

# SparkToro (selective audience-first research)
SPARKTORO_API_KEY=
SPARKTORO_USD_PER_CREDIT=0

# Supadata (optional transcript fallback)
SUPADATA_API_KEY=
SUPADATA_USD_PER_REQUEST=0

# Spending policy (USD). Budgets themselves live in the rpi_budgets table.
RPI_MAX_COST_PER_CREATOR_USD=1.50
RPI_DEFAULT_JOB_BUDGET_USD=10
# Funnel sizes per job (screen = 3 CreatorDB credits each, deep = 5, contact = 15 when recommended)
RPI_STAGE2_SCREEN=25
RPI_STAGE3_ANALYZE=10
# 10 CreatorDB credits per creator; discovery already filters the main audience country
RPI_FETCH_AUDIENCE_DEMOGRAPHICS=false

# Affiliate program terms. The cookie window is unconfirmed: /affiliate-terms says 60 days, /affiliates 90.
RPI_AFFILIATE_COMMISSION_RATE=0.30
# 30% recurring for 12 months (confirmed 2026-10-25). Empty means customer lifetime.
RPI_AFFILIATE_COMMISSION_MONTHS=12
# Internal addresses allowed to receive RPI test sends (comma-separated)
RPI_TEST_RECIPIENTS=
# Email signature under the sender's name, e.g. "Founder & CEO" (logo and website have defaults)
RPI_SIGNATURE_TITLE=
RPI_AFFILIATE_ATTRIBUTION_DAYS=60

# Billing: a dedicated Stripe webhook endpoint for RPI (/rpi/api/v1/webhooks/stripe)
RPI_STRIPE_WEBHOOK_SECRET=
RPI_STRIPE_PRICE_PLAN_MAP={}

# PostHog (person properties only; sends nothing without consent by default)
POSTHOG_API_KEY=
RPI_POSTHOG_REQUIRES_CONSENT=true

# YouTube Analytics OAuth - keep disabled until legal review (KNOWN_LIMITATIONS.md)
RPI_YOUTUBE_ANALYTICS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
RPI_TOKEN_ENCRYPTION_KEY=

# Local development only - synthetic creators; refused when ENVIRONMENT=production
RPI_ENABLE_FIXTURE_PROVIDER=false
